{
  "permissions": {
    "allow": [
      "Bash(bitmagic check:*)",
      "Bash(bitmagic dev:*)",
      "Bash(bitmagic reload:*)",
      "Bash(bitmagic verify:*)",
      "Bash(bitmagic build:*)",
      "Bash(bitmagic whoami:*)",
      "Bash(bitmagic usage:*)",
      "Bash(bitmagic generate:*)",
      "Bash(bitmagic character:*)",
      "Bash(bitmagic cover:*)",
      "Bash(bitmagic forge:*)",
      "Bash(bitmagic tools:*)",
      "Bash(bitmagic exchange status:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bitmagic reload"
          }
        ]
      }
    ]
  }
}
